# 复制到 ~/.config/telegram-agent-bridge.env 后填写 Bot Token 和 Chat ID。
TAB_BOT_TOKEN=
TAB_CHAT_ID=
TAB_BRIDGE_MODE=repl
TAB_AGENT=codex
TAB_AGENT_CMD=codex
TAB_PREFIX=BOT
TAB_STATE_DIR=~/.local/state/telegram-agent-bridge
TAB_WORKDIR=~
TAB_TIMEOUT=600
TAB_TG_CHUNK=4096
TAB_TYPING_INTERVAL=4
TAB_STDIN_INPUT=0
TAB_CODEX_DANGEROUS_BYPASS=0
TAB_CODEX_EXTRA_ARGS=''

CRB_SIGNAL_PATH=~/.local/state/telegram-agent-bridge/input.fifo
CRB_TMUX_SOCKET=codex
CRB_TMUX_SESSION=codex
CRB_AUTO_RECOVER_TMUX=1
CRB_TMUX_SUBMIT_KEY=Tab
CRB_START_AT_END=1
CRB_IMAGE_MODE=repl
CRB_FLOW_MIRROR=0
CRB_LONG_RUNNING_PROGRESS_SECONDS=60
CRB_TELEGRAM_FALLBACK_SECONDS=0
CRB_AUDIO_TRANSCRIBE_CMD='~/.local/share/codex-telegram-bridge/venv/bin/python ~/.local/share/codex-telegram-bridge/src/codex_audio_transcribe.py {path}'
CODEX_BRIDGE_SYSTEMD_UNIT=telegram-agent-bridge.service
