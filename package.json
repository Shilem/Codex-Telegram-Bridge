{
  "name": "codex-telegram-bridge",
  "version": "1.0.0",
  "description": "通过 Telegram 私聊安全控制本机 Codex App Server",
  "type": "module",
  "bin": {
    "ctb": "dist/cli.js",
    "ctb-service": "dist/service.js"
  },
  "files": [
    "dist",
    "deploy",
    "scripts",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "start": "node dist/service.js",
    "dev": "npm run build && node dist/service.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.1",
    "commander": "14.0.1",
    "pino": "9.11.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "@types/proper-lockfile": "4.1.4",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shilem/Codex-Telegram-Bridge.git"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
